{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|images/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[[...route]].ts": {
      "maxDuration": 300
    }
  }
}
