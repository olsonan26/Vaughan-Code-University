# Vaughan Code University environment variables.
# Copy to .env.local for local development. Never commit real values.
#
# RULE: only variables prefixed with VITE_ are exposed to the browser bundle.
# Anything secret (service keys, AI keys) must NOT use the VITE_ prefix and must
# only be read by server-side code (Vercel Functions in /api).

# ---- Public (browser-safe) ----
# Supabase project URL and anon/publishable key. Safe for the browser; access is
# enforced by Row Level Security in the database.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---- Server-only (Vercel Functions) ----
# Supabase service role key. Bypasses RLS. Server-side only, never VITE_.
SUPABASE_SERVICE_ROLE_KEY=""
# Primary AI provider for the server-side AI Gateway. Server-side only, never VITE_.
DEEPSEEK_API_KEY=""
